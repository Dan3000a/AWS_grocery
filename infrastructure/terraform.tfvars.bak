# Sensitive variables (gitignored)

# IP address configuration for security group rules (e.g., SSH access).
manual_ip = "auto"
# manual_ip = "109.193.23.119"  # Uncomment for static IP, comment out "auto" if used.

# AWS SSO profile name for authentication
profile = "324037288022_AdministratorAccess"

# EC2 instance configuration for GroceryMate web servers
instance_type = "t2.micro"
security_group = "sg-0a95162516ad3399f"

launch_template_version = "$Latest"
subnet_ids             = ["subnet-07a5ef67a7c0e2d58", "subnet-09798ff5a05cb8bb7"]
launch_template_id     = "lt-083e2148f7457df67"
ami = "ami-0adc89df9108a6d24"
db_arn = "arn:aws:rds:eu-central-1:324037288022:db:grocerymate"
db_identifier = "grocerymate"
db_credentials_secret_name = "grocerymate-db-credentials"
db_credentials_secret_arn = "arn:aws:secretsmanager:eu-central-1:324037288022:secret:grocerymate-db-credentials-rFVLQ4"
instance_name = "grocerymate-ec2"
